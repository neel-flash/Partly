# Copy to .env.local. Every key is optional; without them Partly runs on demo data.

# Claude writes the first message to each landlord.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Real door-to-door transit times at rush hour (Distance Matrix API) and address geocoding.
GOOGLE_MAPS_API_KEY=

# Live MLS-backed rental listings (https://www.rentcast.io/api).
RENTCAST_API_KEY=

# Set to "off" to hide the simulated Zillow / Apartments.com / Craigslist / Marketplace listings.
PARTLY_DEMO_LISTINGS=on
